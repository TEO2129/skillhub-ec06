<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
    ============================================================
    PARENT : Spring Boot Starter Parent
    Fournit les configurations de base pour Spring Boot
    ============================================================
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <!--
    ============================================================
    IDENTIFICATION DU PROJET
    ============================================================
    -->
    <groupId>com.example</groupId>
    <artifactId>auth-server</artifactId>
    <version>1.0.0</version>
    <name>auth-server</name>
    <description>TP1 - Serveur d'authentification Spring Boot (VOLONTAIREMENT DANGEREUX)</description>

    <!--
    ============================================================
    PROPRIÉTÉS : Version de Java
    ============================================================
    -->
    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <!--
    ============================================================
    DÉPENDANCES
    ============================================================
    -->
    <dependencies>
        <!--
        Spring Boot Web - Pour créer une API REST
        Fournit : @RestController, @RequestMapping, etc.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
        Spring Data JPA - Pour accéder à la base de données
        Fournit : @Entity, @Repository, JpaRepository, etc.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
        H2 Database - Base de données en mémoire pour le développement
        Permet de démarrer sans installer MySQL
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
        Spring Boot Test - Pour les tests unitaires
        Fournit : @SpringBootTest, @Transactional, etc.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
         TP1 : ABSENCE VOLONTAIRE de Spring Security
        Pas de BCryptPasswordEncoder, pas de sécurité Spring
        -->
    </dependencies>

    <!--
    ============================================================
    PLUGINS DE BUILD
    ============================================================
    -->
    <build>
        <plugins>
            <!-- Plugin Spring Boot - Permet de lancer l'app avec mvn spring-boot:run -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>